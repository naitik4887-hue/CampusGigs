PORT=3000
NODE_ENV=development

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# SMTP settings (example: Gmail with an App Password)
# Gmail: enable 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="My App <youraddress@gmail.com>"

# OTP settings
OTP_EXPIRY_MINUTES=10

# Marketplace
# Only emails from these domains can sign up (comma-separated).
#   ".ac.in"      matches any address ending in .ac.in (e.g. name@mdu.ac.in, name@cs.du.ac.in)
#   "mdu.ac.in"   matches that domain and its subdomains (e.g. name@stu.mdu.ac.in)
# Add your own university's domain here if it isn't covered.
# For quick testing you can temporarily add gmail.com, but remove it before real use.
ALLOWED_EMAIL_DOMAINS=.edu,.edu.in,.ac.in

# Public address of your site, used for links inside notification emails
APP_URL=http://localhost:3000
